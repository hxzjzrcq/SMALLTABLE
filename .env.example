# Initial passwords only; replace examples before first start.
# Existing credentials.json is authoritative; ordinary Config never holds passwords.
ROOM_PASSWORD=replace-this-room-password
DM_PASSWORD=replace-this-dm-password
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
COOKIE_SECURE=false
# Optional settings file; defaults to smalltable.config.json in the working directory.
# SMALLTABLE_CONFIG=./smalltable.config.json
# Migrate old MAX_SEATS/IDLE_MINUTES/MAP_*/TOKEN_* settings into JSON first.
# See docs/CONFIGURATION.md; the old limit environment variables cause startup failure.
